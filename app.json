{
  "expo": {
    "name": "contacts-manager",
    "slug": "contactsmanager",
    "version": "1.0.0",
    "orientation": "portrait", 
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "plugins": [
      [
        "expo-contacts",
        {
          "contactsPermission": "Allow contact_manager to access your contacts."
        }
      ]
    ],
    "android": {
      "permissions": [
        "android.permission.READ_CONTACTS"
      ]
    },
    "extra": {
      "eas": {
        "projectId": "12a089a4-9cc9-4f5e-be74-be439a0ad1f4"
      }
    },
    "owner": "starkiller_06"
  }
}